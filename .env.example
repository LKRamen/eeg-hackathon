# Copy to .env and fill in. Values required before running live pipeline.

# OpenAI — persona synthesis, palette/fonts, voice, brand name, match reasons, embeddings
OPENAI_API_KEY=

# Replicate — FLUX.1 schnell for logos and mockups
REPLICATE_API_TOKEN=

# Instagram — optional login to avoid 403 rate limits on instaloader
IG_USERNAME=
IG_PASSWORD=

# X (Twitter) — twscrape uses a real X account, no API key needed (free)
X_USERNAME=
X_PASSWORD=
X_EMAIL=
X_EMAIL_PASSWORD=

# Supabase — Postgres + Storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo mode — serve cached pipeline result when handle matches
CACHE_MODE=false
DEMO_HANDLE=
