# Copy to .env and fill in.

# OpenAI — persona synthesis, palette, voice, brand names, clustering, embeddings
OPENAI_API_KEY=

# Hugging Face — free image generation (FLUX.1-schnell is Apache 2.0, no cost)
# Get token at huggingface.co → Settings → Access Tokens → New token (read access is enough)
HF_TOKEN=
# Optional: swap the image model (default is FLUX.1-schnell)
# Other free options: stabilityai/stable-diffusion-xl-base-1.0
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Supabase — Postgres + Storage (free tier)
# Project Settings → API → Project URL + service_role secret key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Canva Connect API — optional, falls back to Pillow + HF if not set
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_SOCIAL_TEMPLATE_IDS=
CANVA_MOCKUP_TEMPLATE_IDS=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Demo cache mode
CACHE_MODE=false
DEMO_HANDLE=
