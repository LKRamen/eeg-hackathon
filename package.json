{
  "name": "halo",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev:web": "pnpm --filter @halo/web dev",
    "dev:api": "cd apps/api && uvicorn main:app --reload",
    "build:web": "pnpm --filter @halo/web build",
    "lint:web": "pnpm --filter @halo/web lint"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
